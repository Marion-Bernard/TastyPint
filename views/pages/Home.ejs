<!DOCTYPE html>
<html lang="fr">
<head>
	<%- include("../partials/Head", { title: "TastyPint" }) %>
</head>
<body class="d-grid min-vh-100">
	<%- include("../partials/Header") %>

  <section class="hero d-flex align-items-center justify-content-center text-center">

    <div class="container hero-content">

        <h1 class="display-1 fw-bold">
            Tasty Pint
        </h1>

        <p class="lead fs-3">
            Discover the perfect beer to enjoy with your meal.
            Delicious food and Brewdog's beer pairings
        </p>

        <a href="#accords" class="btn btn-warning btn-lg rounded-pill px-5 mt-4">
          Find the perfect beer
        </a>

    </div>

</section>

<%- include("../partials/Banner") %>

<section id="accords" class="py-5">

    <div class="container">

        <h2 class="text-center mb-5">
            Choisissez votre repas
        </h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card food-card shadow h-100">
                    <img src="/images/burger.jpg" class="card-img-top">

                    <div class="card-body text-center">
                        <h3 class="card-title">
                            Burger 🍔
                        </h3>
                        <p>
                            IPA ou Pale Ale pour relever les saveurs.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card food-card shadow h-100">
                    <img src="/images/pizza.jpg" class="card-img-top">
                    <div class="card-body text-center">
                        <h3>
                            Pizza 🍕
                        </h3>
                        <p>
                            Lager fraîche et légère.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card food-card shadow h-100">
                    <img src="/images/steak.jpg" class="card-img-top">
                    <div class="card-body text-center">
                        <h3>
                            Viande 🥩
                        </h3>
                        <p>
                            Stout ou bière ambrée.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
	<%- include("../partials/Footer") %>
</body>
</html>
<!DOCTYPE html>
<html lang="fr">

<head>
	<%- include("../partials/head", { title: "Tasty Pint Error" }) %>
		<link rel="stylesheet" href="./../css/404.css">
</head>


<body class="d-grid min-vh-100">
	<%- include ("../partials/header") %>
	<div class="main hero">
		<h1 class="text-white">Error <%= status %></h1>
		<div class="face">
			<div class="band">
				<div class="top bg-white"></div>
				<div class="middle bg-brand"></div>
				<div class="bottom bg-warning"></div>
			</div>
			<div class="eyes"></div>
			<div class="dimples"></div>
			<div class="mouth"></div>
		</div>
	
		<% if (status===500) { %>
			<h1 class="text-white">Oops! Something went wrong internally ! </h1>
		<% } else { %>
			<h1 class="text-white">Oops! Something went wrong!</h1>
		<% } %>
		<div class="text-center">
			<a href="/" class="btn btn-warning btn-lg rounded-pill px-5 mt-4">Return to Home</a>
		</div>
	</div>
		<%- include ("../partials/footer") %>
</body>
</html>
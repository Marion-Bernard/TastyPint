<!DOCTYPE html>
<html lang="fr">

<head>
	<%- include("../partials/Head", { title: "TastyPint" }) %>
</head>

<body class="d-grid min-vh-100">
	<%- include("../partials/Header") %>
	<main>
		<section class="hero d-flex align-items-center justify-content-center text-center">
			<div class="container hero-content">
				<h1 class="display-1 fw-bold">
					Tasty Pint
				</h1>

				<p class="lead fs-3">
					Discover the perfect beer to enjoy with your meal.
					Delicious food and Brewdog's beer pairings
				</p>

				<a href="#accords" class="btn btn-warning btn-lg rounded-pill px-5 mt-4">
					Find the perfect beer
				</a>
			</div>
		</section>

		<%- include("../partials/Banner") %>

			<section id="accords" class="py-5">
				<div class="container">
					<h2 class="text-center mb-5">
						Beers that perfectly match your meal
					</h2>
					<div class="row g-4">
						<% if (beers && beers.length> 0) { %>
							<% beers.forEach(beer=> { %>
								<div class="col-md-4">
									<div class="card meal-card shadow h-100">
										<div class="card-body text-center">
											<h3 class="card-title">
												<%= beer.name %>
											</h3>

											<p>
												<%= beer.name %>
											</p>
										</div>
									</div>
								</div>
							<% }) %>
						<% } else { %>
							<div class="col-12 text-center">
								<p>No beer matches your meal :O</p>
							</div>
						<% } %>
					</div>
				</div>
			</section>
		</main>

			<%- include("../partials/Footer") %>
</body>
</html>